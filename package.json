{
  "name": "@ten98/runtime",
  "version": "0.1.11",
  "description": "Shared HTTP, OpenRouter and OIDC primitives for ten98 applications",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "migration-ledger.mjs",
    "migration-ledger.d.mts",
    "LICENSE",
    "README.md",
    "architecture.json",
    "check.mjs",
    "check.d.mts",
    "src/index.mts",
    "src/migration-ledger.mts",
    "tsconfig.json",
    "database-policy.mjs",
    "database-policy.d.mts",
    "src/database-policy.mts",
    "src/check.mts"
  ],
  "scripts": {
    "check:architecture": "node check.mjs .",
    "typecheck": "npm run check:architecture && tsc --project tsconfig.json --noEmit",
    "build": "npm run check:architecture && tsc --project tsconfig.json",
    "test": "npm run check:architecture && tsc --project tsconfig.json && tsc --project tests/tsconfig.api.json && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ten98-IO-Company/ten98-code-system.git"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
