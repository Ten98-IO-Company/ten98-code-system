{
  "name": "@ten98/runtime",
  "version": "0.17.0",
  "packageManager": "pnpm@11.19.0",
  "description": "Shared HTTP, OpenRouter and OIDC primitives for ten98 applications",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./browser": {
      "types": "./browser.d.mts",
      "import": "./browser.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "browser.mjs",
    "browser.d.mts",
    "migration-ledger.mjs",
    "migration-ledger.d.mts",
    "client-address.mjs",
    "client-address.d.mts",
    "ses-email.mjs",
    "ses-email.d.mts",
    "sns-notification.mjs",
    "sns-notification.d.mts",
    "email-feedback.mjs",
    "email-feedback.d.mts",
    "capability-token.mjs",
    "capability-token.d.mts",
    "json-body.mjs",
    "json-body.d.mts",
    "cloudflare-email.mjs",
    "cloudflare-email.d.mts",
    "email-message.mjs",
    "email-message.d.mts",
    "public-hostname.mjs",
    "public-hostname.d.mts",
    "provider-fetch.mjs",
    "provider-fetch.d.mts",
    "LICENSE",
    "README.md",
    "architecture.json",
    "check.mjs",
    "check.d.mts",
    "src/index.mts",
    "src/browser.mts",
    "src/migration-ledger.mts",
    "src/client-address.mts",
    "src/ses-email.mts",
    "src/sns-notification.mts",
    "src/email-feedback.mts",
    "src/capability-token.mts",
    "src/json-body.mts",
    "src/cloudflare-email.mts",
    "src/email-message.mts",
    "src/public-hostname.mts",
    "src/provider-fetch.mts",
    "tsconfig.json",
    "database-policy.mjs",
    "database-policy.d.mts",
    "src/database-policy.mts",
    "src/check.mts"
  ],
  "scripts": {
    "check:architecture": "node check.mjs .",
    "typecheck": "pnpm run check:architecture && tsc --project tsconfig.json --noEmit",
    "build": "pnpm run check:architecture && tsc --project tsconfig.json",
    "test": "pnpm run check:architecture && tsc --project tsconfig.json && tsc --project tests/tsconfig.api.json && tsc --project tests/tsconfig.tests.json && node --test tests/*.test.mts",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ten98-IO-Company/ten98-code-system.git"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
