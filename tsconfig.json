{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": ".",
    "types": [
      "node"
    ],
    "newLine": "lf"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
